# Copy to .env.local (or .env) and fill in.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/outbound_os
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/outbound_os

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-32-byte-hex
TRACKING_SECRET=replace-me
CRON_SECRET=replace-me
ALLOWED_EMAILS=owner@example.com,admin@example.com

# Mock providers simulate Apify / Resend / IMAP locally.
MOCK_PROVIDERS=true
APIFY_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@example.com
RESEND_FROM_NAME=Acme Studio
RESEND_REPLY_TO=hello@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
