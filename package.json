{
  "name": "outbound-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3000",
    "ui:dev": "NEXT_DIST_DIR=.next-ui next dev --hostname 127.0.0.1 --port 3001",
    "ui:build": "NEXT_DIST_DIR=.next-ui-build next build",
    "ui:start": "NEXT_DIST_DIR=.next-ui-build next start --hostname 127.0.0.1 --port 3002",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "fmt:check": "prettier --check components/app-shell.tsx components/nav-meta.tsx components/shell-preferences.tsx components/ui/button.tsx components/ui/sheet.tsx components/ui/tooltip.tsx app/layout.tsx app/ui-review/page.tsx app/globals.css tests/e2e/shell.spec.ts playwright.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/reset.ts",
    "tick": "tsx --env-file=.env scripts/tick.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "postgres": "^3.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
